/* =========================================================
   MOBILE CONTROLS
========================================================= */

function setupMobileControls() {

    document
        .querySelectorAll(
            "#mobileControls button"
        )
        .forEach(button => {

            const key =
                button.dataset.key.toLowerCase();


            button.addEventListener(
                "touchstart",
                function(event) {

                    event.preventDefault();

                    keysPressed.add(key);

                },
                {
                    passive: false
                }
            );


            button.addEventListener(
                "touchend",
                function(event) {

                    event.preventDefault();

                    keysPressed.delete(key);

                },
                {
                    passive: false
                }
            );


            button.addEventListener(
                "mousedown",
                function() {

                    keysPressed.add(key);

                }
            );


            button.addEventListener(
                "mouseup",
                function() {

                    keysPressed.delete(key);

                }
            );

        });

}


/* =========================================================
   CHECKPOINT COLLISION
========================================================= */

function checkCheckpointCollision() {

    const checkpoints =
        document.querySelectorAll(
            ".checkpoint.unlocked"
        );


    checkpoints.forEach(
        checkpoint => {

            const rect =
                checkpoint.getBoundingClientRect();

            const playerRect =
                player.getBoundingClientRect();


            const touching =
                playerRect.left < rect.right &&
                playerRect.right > rect.left &&
                playerRect.top < rect.bottom &&
                playerRect.bottom > rect.top;


            if (touching) {

                const number =
                    Number(
                        checkpoint.dataset.checkpoint
                    );


                if (
                    !game.completedCheckpoints
                        .includes(number)
                ) {

                    openCheckpoint(number);

                }

            }

        }
    );

}


/* =========================================================
   CHECKPOINT VISUALS
========================================================= */

function updateCheckpointVisuals() {

    for (
        let i = 1;
        i <= 5;
        i++
    ) {

        const checkpoint =
            document.getElementById(
                `checkpoint${i}`
            );


        if (!checkpoint) continue;


        checkpoint.classList.remove(
            "unlocked",
            "locked",
            "completed"
        );


        if (
            game.completedCheckpoints
                .includes(i)
        ) {

            checkpoint.classList.add(
                "completed"
            );

            checkpoint.disabled = true;

        }

        else if (
            i === 1 ||
            game.completedCheckpoints
                .includes(i - 1)
        ) {

            checkpoint.classList.add(
                "unlocked"
            );

            checkpoint.disabled = false;

        }

        else {

            checkpoint.classList.add(
                "locked"
            );

            checkpoint.disabled = true;

        }

    }

}


/* =========================================================
   OPEN CHECKPOINT
========================================================= */

function openCheckpoint(number) {

    if (
        number !== 1 &&
        !game.completedCheckpoints
            .includes(number - 1)
    ) {

        return;

    }


    game.currentCheckpoint =
        number;

    game.currentQuestion = 0;


    switch (number) {

        case 1:
            openCP1();
            break;

        case 2:
            openCP2();
            break;

        case 3:
            openCP3();
            break;

        case 4:
            openCP4();
            break;

        case 5:
            openCP5();
            break;

    }

}


