/* =========================================================
   COMPLETE CHECKPOINT
========================================================= */

function completeCheckpoint(
    checkpoint,
    bonus
) {

    game.score += bonus;


    if (
        !game.completedCheckpoints
            .includes(checkpoint)
    ) {

        game.completedCheckpoints
            .push(checkpoint);

    }


    updateHUD();

    updateCheckpointVisuals();


    showFeedback(
        true,
        "🎉 SYABAS!",
        `Checkpoint ${checkpoint} berjaya!<br><br>
         ⭐ +${bonus} Markah<br><br>
         Checkpoint seterusnya telah dibuka!`,
        bonus,
        function() {

            closeActivityModal();

            resetPlayerPosition();


            if (
                checkpoint === 5
            ) {

                finishGame();

            }

        }
    );

}


/* =========================================================
   FEEDBACK
========================================================= */

let feedbackCallback = null;


function showFeedback(
    correct,
    title,
    message,
    points,
    callback
) {

    if (!feedbackModal) return;


    feedbackTitle.textContent =
        title;


    feedbackMessage.innerHTML =
        message;


    feedbackScore.textContent =
        points > 0
            ? `+${points} ⭐`
            : "Cuba semula 💪";


    if (correct) {

        feedbackIcon.textContent =
            "🎉";

        feedbackTitle.style.color =
            "#2e7d32";

    }

    else {

        feedbackIcon.textContent =
            "💪";

        feedbackTitle.style.color =
            "#ef6c00";

    }


    feedbackCallback =
        callback || null;


    feedbackModal.classList.remove(
        "hidden"
    );

}


function closeFeedback() {

    if (!feedbackModal) return;


    feedbackModal.classList.add(
        "hidden"
    );


    const callback =
        feedbackCallback;


    feedbackCallback =
        null;


    if (callback) {

        callback();

    }

}


/* =========================================================
   FINISH GAME
========================================================= */

function finishGame() {

    stopSpeechRecognition();

    closeActivityModal();


    finalName.textContent =
        game.studentName;

    finalScore.textContent =
        game.score;

    finalCheckpoint.textContent =
        `${game.completedCheckpoints.length} / 5`;

    finalActivities.textContent =
        `${game.activitiesCompleted} / ${game.totalActivities}`;


    const percentage =
        game.totalActivities
            ? Math.round(
                (
                    game.activitiesCompleted /
                    game.totalActivities
                ) * 100
            )
            : 0;


    finalPercentage.textContent =
        `${percentage}%`;


    showScreen(
        finishScreen
    );

}


