/* =========================================================
   PLAYER MOVEMENT
========================================================= */

const keysPressed = new Set();


function setupKeyboardControls() {

    document.addEventListener(
        "keydown",
        function(event) {

            const key =
                event.key.toLowerCase();


            if (
                [
                    "w",
                    "a",
                    "s",
                    "d",
                    "arrowup",
                    "arrowdown",
                    "arrowleft",
                    "arrowright"
                ].includes(key)
            ) {

                event.preventDefault();

                keysPressed.add(key);

            }

        }
    );


    document.addEventListener(
        "keyup",
        function(event) {

            const key =
                event.key.toLowerCase();

            keysPressed.delete(key);

        }
    );


    requestAnimationFrame(
        movementLoop
    );

}


/* =========================================================
   MOVEMENT LOOP
========================================================= */

function movementLoop() {

    if (
        worldScreen &&
        worldScreen.classList.contains("active")
    ) {

        let dx = 0;
        let dy = 0;


        if (
            keysPressed.has("w") ||
            keysPressed.has("arrowup")
        ) {

            dy -= game.player.speed;

        }


        if (
            keysPressed.has("s") ||
            keysPressed.has("arrowdown")
        ) {

            dy += game.player.speed;

        }


        if (
            keysPressed.has("a") ||
            keysPressed.has("arrowleft")
        ) {

            dx -= game.player.speed;

        }


        if (
            keysPressed.has("d") ||
            keysPressed.has("arrowright")
        ) {

            dx += game.player.speed;

        }


        if (
            dx !== 0 ||
            dy !== 0
        ) {

            movePlayer(
                dx,
                dy
            );

        }

    }


    requestAnimationFrame(
        movementLoop
    );

}


/* =========================================================
   MOVE PLAYER
========================================================= */

function movePlayer(
    dx,
    dy
) {

    game.player.x += dx;

    game.player.y += dy;


    game.player.x =
        Math.max(
            2,
            Math.min(
                96,
                game.player.x
            )
        );


    game.player.y =
        Math.max(
            8,
            Math.min(
                90,
                game.player.y
            )
        );


    updatePlayerPosition();

    checkCheckpointCollision();

}


/* =========================================================
   UPDATE PLAYER POSITION
========================================================= */

function updatePlayerPosition() {

    if (!player) return;


    player.style.left =
        `${game.player.x}%`;

    player.style.top =
        `${game.player.y}%`;

}


/* =========================================================
   RESET PLAYER
========================================================= */

function resetPlayerPosition() {

    game.player.x = 5;

    game.player.y = 53;

    updatePlayerPosition();

