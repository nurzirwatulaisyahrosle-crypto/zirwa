function handleCP1Answer(correct) {

    if (!correct) {

        showFeedback(
            false,
            "Cuba lagi!",
            "Dengarkan sekali lagi dan pilih jawapan yang betul. 👂",
            0,
            () => {

                openCP1();

            }
        );

        return;

    }


    game.score += 5;
    game.activitiesCompleted++;


    if (
        game.currentQuestion <
        cp1Questions.length - 1
    ) {

        game.currentQuestion++;


        showFeedback(
            true,
            "Syabas!",
            "Jawapan kamu betul! ⭐",
            5,
            () => {

                openCP1();

            }
        );

    }

    else {

        completeCheckpoint(
            1,
            10
        );

    }


    updateHUD();

}


