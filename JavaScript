function setupDragAndDrop() {

    const items =
        document.querySelectorAll(
            ".drag-item"
        );


    const zones =
        document.querySelectorAll(
            ".drop-zone"
        );


    items.forEach(item => {

        item.addEventListener(
            "dragstart",
            function(event) {

                event.dataTransfer.setData(
                    "text/plain",
                    this.dataset.item
                );

            }
        );

    });


    zones.forEach(zone => {

        zone.addEventListener(
            "dragover",
            function(event) {

                event.preventDefault();

                this.classList.add(
                    "drag-over"
                );

            }
        );


        zone.addEventListener(
            "dragleave",
            function() {

                this.classList.remove(
                    "drag-over"
                );

            }
        );


        zone.addEventListener(
            "drop",
            function(event) {

                event.preventDefault();

                this.classList.remove(
                    "drag-over"
                );


                const item =
                    event.dataTransfer
                        .getData(
                            "text/plain"
                        );


                if (
                    item ===
                    this.dataset.target
                ) {

                    game.score += 5;
                    game.activitiesCompleted++;


                    showFeedback(
                        true,
                        "Hebat!",
                        "Kamu berjaya mengikuti arahan! 🎉",
                        5,
                        () => {

                            cp2Step = 1;

                            renderCP2();

                        }
                    );

                }

                else {

                    showFeedback(
                        false,
                        "Cuba lagi!",
                        "Dengar arahan sekali lagi. 🔊",
                        0,
                        () => {

                            renderCP2Step1();

                        }
                    );

                }

            }
        );

    });

}


