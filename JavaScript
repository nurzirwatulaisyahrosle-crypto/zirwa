/* =========================================================
   CP5 SPEECH
========================================================= */

function startCP5Recognition(
    question,
    button
) {

    if (!game.speechSupported) {

        showSpeechUnsupported();

        return;

    }


    if (game.isRecording) {

        stopSpeechRecognition();

        return;

    }


    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    const recognition =
        new SpeechRecognition();


    game.speechRecognition =
        recognition;

    game.isRecording = true;


    recognition.lang = "ms-MY";

    recognition.continuous = true;

    recognition.interimResults = true;

    recognition.maxAlternatives = 1;


    button.textContent =
        "⏹ SELESAI RAKAMAN";

    button.classList.add(
        "recording"
    );


    const display =
        document.getElementById(
            "speechDisplay"
        );

    const status =
        document.getElementById(
            "speechStatus"
        );

    const percentage =
        document.getElementById(
            "wordPercentage"
        );

    const progress =
        document.getElementById(
            "wordProgress"
        );


    recognition.onstart =
        function() {

            status.textContent =
                "🎤 Sedang mendengar...";

        };


    recognition.onresult =
        function(event) {

            let finalText = "";
            let interimText = "";


            for (
                let i = event.resultIndex;
                i < event.results.length;
                i++
            ) {

                const result =
                    event.results[i];


                if (
                    result.isFinal
                ) {

                    finalText +=
                        result[0].transcript + " ";

                }

                else {

                    interimText +=
                        result[0].transcript;

                }

            }


            const combined =
                (
                    finalText ||
                    interimText
                ).trim();


            display.textContent =
                combined ||
                "Mendengar...";


            updateWordBlocks(
                combined,
                question.words
            );


            const match =
                calculateWordMatch(
                    combined,
                    question.words
                );


            percentage.textContent =
                `${match.percentage}%`;

            progress.style.width =
                `${match.percentage}%`;


            if (
                match.percentage >= 80
            ) {

                recognition.stop();

            }

        };


    recognition.onerror =
        function(event) {

            if (
                event.error ===
                "not-allowed"
            ) {

                status.textContent =
                    "🎤 Mikrofon tidak dibenarkan. Sila benarkan akses mikrofon.";

            }

            else {

                status.textContent =
                    "Cuba bercakap sekali lagi.";

            }

        };


    recognition.onend =
        function() {

            game.isRecording = false;


            button.textContent =
                "🎤 RAKAM SUARA";

            button.classList.remove(
                "recording"
            );


            const text =
                display.textContent;


            const result =
                calculateWordMatch(
                    text,
                    question.words
                );


            if (
                result.percentage >= 80
            ) {

                game.score += 5;

                game.activitiesCompleted++;


                if (
                    game.currentQuestion <
                    cp5Sentences.length - 1
                ) {

                    game.currentQuestion++;


                    showFeedback(
                        true,
                        "Tahniah!",
                        "Kamu berjaya menguasai ayat! 🏆",
                        5,
                        () => {

                            openCP5();

                        }
                    );

                }

                else {

                    completeCheckpoint(
                        5,
                        10
                    );

                }


                updateHUD();

            }

            else if (
                text &&
                text !==
                "Tekan mikrofon dan ulang ayat."
            ) {

                showFeedback(
                    false,
                    "Cuba lagi!",
                    "Dengarkan ayat sekali lagi. Kamu boleh! 👂",
                    0,
                    () => {

                        openCP5();

                    }
                );

            }

        };


    try {

        recognition.start();

    }

    catch (error) {

        console.error(
            "Speech Recognition error:",
            error
        );

        game.isRecording = false;

    }

}


/* =========================================================
   LIVE WORD BLOCKS
========================================================= */

function updateWordBlocks(
    transcript,
    targetWords
) {

    const normalised =
        normaliseText(
            transcript
        );


    document
        .querySelectorAll(
            ".word-block"
        )
        .forEach(block => {

            const word =
                normaliseText(
                    block.dataset.word
                );


            if (
                normalised.includes(word)
            ) {

                block.classList.add(
                    "matched"
                );

            }

            else {

                block.classList.remove(
                    "matched"
                );

            }

        });

}


/* =========================================================
   CALCULATE WORD MATCH
========================================================= */

function calculateWordMatch(
    transcript,
    targetWords
) {

    const normalised =
        normaliseText(
            transcript
        );


    let matched = 0;


    targetWords.forEach(
        word => {

            const target =
                normaliseText(
                    word
                );


            if (
                normalised.includes(
                    target
                )
            ) {

                matched++;

            }

        }
    );


    const percentage =
        targetWords.length
            ? Math.round(
                (
                    matched /
                    targetWords.length
                ) * 100
            )
            : 0;


    return {
        matched,
        total: targetWords.length,
        percentage
    };

}


