========================================================= */

function setupButtons() {


    /* MULA */

    if (startButton) {

        startButton.type = "button";

        startButton.addEventListener(
            "click",
            function(event) {

                event.preventDefault();

                startGame();

            }
        );

    }


    /* MAIN SEMULA */

    if (restartButton) {

        restartButton.type = "button";

        restartButton.addEventListener(
            "click",
            function(event) {

                event.preventDefault();

                resetGame();

            }
        );

    }


    /* TUTUP AKTIVITI */

    if (closeActivity) {

        closeActivity.type = "button";

        closeActivity.addEventListener(
            "click",
            closeActivityModal
        );

    }


    /* FEEDBACK */

    if (feedbackButton) {

        feedbackButton.type = "button";

        feedbackButton.addEventListener(
            "click",
            closeFeedback
        );

    }


    /* ENTER */

    if (studentNameInput) {

        studentNameInput.addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    startGame();

                }

            }
        );

    }


    /* CHECKPOINT */

    document
        .querySelectorAll(".checkpoint")
        .forEach(button => {

            button.addEventListener(
                "click",
                function(event) {

                    event.preventDefault();

                    const checkpoint =
                        Number(
                            this.dataset.checkpoint
                        );

                    openCheckpoint(
                        checkpoint
                    );

                }
            );

        });

}


/* =========================================================
   START GAME
========================================================= */

function startGame() {

    console.log("Butang MULA ditekan.");


    if (!studentNameInput) {

        console.error(
            "Input nama tidak dijumpai."
        );

        return;

    }


    const name =
        studentNameInput.value.trim();


    if (!name) {

        if (startError) {

            startError.textContent =
                "Sila masukkan nama kamu dahulu 😊";

        }

        studentNameInput.focus();

        return;

    }


    game.studentName = name;


    if (startError) {

        startError.textContent = "";

    }


    if (hudName) {

        hudName.textContent =
            game.studentName;

    }


    showScreen(
        worldScreen
    );


    resetPlayerPosition();

    updateHUD();

    updateCheckpointVisuals();


    console.log(
        "Berjaya masuk ke dunia permainan."
    );

}


/* =========================================================
   SCREEN MANAGEMENT
========================================================= */

function showScreen(screen) {

    if (!screen) return;


    if (startScreen) {

        startScreen.classList.remove(
            "active"
        );

    }

    if (worldScreen) {

        worldScreen.classList.remove(
            "active"
        );

    }

    if (finishScreen) {

        finishScreen.classList.remove(
            "active"
        );

    }


    screen.classList.add(
        "active"
    );

}


/* =========================================================
   RESET GAME
========================================================= */

function resetGame() {

    game.studentName = "";

    game.score = 0;

    game.currentCheckpoint = 0;

    game.completedCheckpoints = [];

    game.activitiesCompleted = 0;

    game.currentActivity = null;

    game.currentQuestion = 0;

    game.player.x = 5;

    game.player.y = 53;


    if (studentNameInput) {

        studentNameInput.value = "";

