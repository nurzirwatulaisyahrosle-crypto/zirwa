========================================================= */

function startSpeechRecognition(
    keywords,
    button,
    callback,
    requireAll = false
) {

    if (!game.speechSupported) {

        showSpeechUnsupported();

        return;

    }


    if (game.isRecording) {

        stopSpeechRecognition();

        return;

    }


    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    const recognition =
        new SpeechRecognition();


    game.speechRecognition =
        recognition;

    game.isRecording = true;


    recognition.lang =
        "ms-MY";

    recognition.continuous =
        false;

    recognition.interimResults =
        true;

    recognition.maxAlternatives =
        1;


    button.textContent =
        "⏹ SELESAI RAKAMAN";

    button.classList.add(
        "recording"
    );


    const display =
        document.getElementById(
            "speechDisplay"
        );

    const status =
        document.getElementById(
            "speechStatus"
        );


    recognition.onstart =
        function() {

            status.textContent =
                "🎤 Sedang mendengar...";

        };


    recognition.onresult =
        function(event) {

            let transcript = "";


            for (
                let i = event.resultIndex;
                i < event.results.length;
                i++
            ) {

                transcript +=
                    event.results[i][0]
                        .transcript;

            }


            transcript =
                transcript.trim();


            display.textContent =
                transcript ||
                "Mendengar...";

        };


    recognition.onerror =
        function(event) {

            game.isRecording = false;


            button.textContent =
                "🎤 RAKAM SUARA";

            button.classList.remove(
                "recording"
            );


            if (
                event.error ===
                "not-allowed"
            ) {

                status.textContent =
                    "Mikrofon tidak dibenarkan.";

            }

            else if (
                event.error ===
                "no-speech"
            ) {

                status.textContent =
                    "Tiada suara dikesan.";

            }

            else {

                status.textContent =
                    "Cuba lagi.";

            }

        };


    recognition.onend =
        function() {

            game.isRecording = false;


            button.textContent =
                "🎤 RAKAM SUARA";

            button.classList.remove(
                "recording"
            );


            const transcript =
                display.textContent;


            if (
                !transcript ||
                transcript ===
                "Tekan mikrofon dan jawab."
            ) {

                status.textContent =
                    "Tiada jawapan dikesan.";

                return;

            }


            callback(
                transcript,
                keywords,
                requireAll
            );

        };


    try {

        recognition.start();

    }

    catch (error) {

        console.error(
            "Speech Recognition error:",
            error
        );

        game.isRecording = false;

        button.textContent =
            "🎤 RAKAM SUARA";

        button.classList.remove(
            "recording"
        );

    }

}


/* =========================================================
   STOP SPEECH RECOGNITION
========================================================= */

function stopSpeechRecognition() {

    if (
        game.speechRecognition
    ) {

        try {

            game.speechRecognition.stop();

        }

        catch (error) {

            console.log(
                "Speech recognition stopped."
            );

        }

    }


    game.isRecording =
        false;

}


/* =========================================================
   TEXT TO SPEECH
========================================================= */

function speakText(text) {

    if (
        !game.speechSynthesisSupported
    ) {

        return;

    }


    window.speechSynthesis.cancel();


    const utterance =
        new SpeechSynthesisUtterance(
            text
        );


    utterance.lang =
        "ms-MY";

    utterance.rate =
        0.85;

    utterance.pitch =
        1;

    utterance.volume =
        1;


    const voices =
        window.speechSynthesis
            .getVoices();


    const malayVoice =
        voices.find(
            voice =>
                voice.lang
                    .toLowerCase()
                    .startsWith("ms")
        );


    if (malayVoice) {

        utterance.voice =
            malayVoice;

    }


    window.speechSynthesis.speak(
        utterance
    );

}


/* =========================================================
   NORMALISE TEXT
========================================================= */

function normaliseText(text) {

    return String(text || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .replace(
            /[^a-z0-9\s]/g,
            " "
        )
        .replace(
            /\s+/g,
            " "
        )
        .trim();

}


/* =========================================================
   KEYWORD MATCHING
========================================================= */

function keywordMatch(
    transcript,
    keywords
) {

    const text =
        normaliseText(
            transcript
        );


    return keywords.some(
        keyword =>
            text.includes(
                normaliseText(
                    keyword
                )
            )
    );

}


/* =========================================================
   ALL KEYWORD MATCHING
========================================================= */

function keywordMatchAll(
    transcript,
    keywords
) {

    const text =
        normaliseText(
            transcript
        );


    return keywords.every(
        keyword =>
            text.includes(
                normaliseText(
                    keyword
                )
            )
    );

}


